[Unit]
Description=AppleSpy FastAPI (мини-апп ЗЯ)
After=network.target postgresql.service

[Service]
User=admin
WorkingDirectory=/home/admin/applespy
Environment=WEBAPP_DIR=/var/www/applespy.panoff.dev
ExecStart=/home/admin/applespy/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8020 --proxy-headers --forwarded-allow-ips=127.0.0.1
MemoryMax=800M
MemoryHigh=650M
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
