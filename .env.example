# ---------- Telegram ----------
# Токен от @BotFather
BOT_TOKEN=
# Публичный https-домен мини-аппа (обязателен для Telegram WebApp)
WEBAPP_URL=https://applespy.panoff.dev
# Режим бота: polling | webhook
BOT_MODE=polling
WEBHOOK_PATH=/tg/webhook
# Секрет для проверки подлинности апдейтов при BOT_MODE=webhook
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---------- База ----------
POSTGRES_USER=applespy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=applespy
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---------- Золотое Яблоко ----------
# Город и регион задаются ФИАС-кодами и должны быть согласованы.
# У Москвы это один и тот же код, у Тюмени регион отдельный — если прислать
# несогласованную пару, ЗЯ начнёт сам выбирать магазин и наличие поедет.
#   Тюмень:  9ae64229-9f7b-4149-b27a-d1f6ec74b5ce / 54049357-326d-4b8f-b224-3c6dc25d6dd3
#   Москва:  0c5b2444-70a0-4932-980c-b4dc0d3f02b5 / 0c5b2444-70a0-4932-980c-b4dc0d3f02b5
GA_CITY_ID=9ae64229-9f7b-4149-b27a-d1f6ec74b5ce
GA_REGION_ID=54049357-326d-4b8f-b224-3c6dc25d6dd3

# Пул прокси через запятую, формат http://user:pass@host:port или socks5://...
# Пусто = запросы идут внутри браузерной сессии, работает и с датацентрового
# сервера. Подходят только РЕЗИДЕНТНЫЕ или мобильные прокси с РФ-гео:
# датацентровые (включая «индивидуальные IPv4» у провайдеров прокси) ЗЯ
# отсекает по типу сети. С резидентными включается быстрый путь через httpx.
GA_PROXIES=

# Playwright нужен в любом режиме: без браузера device-check не пройти
GA_BROWSER_FALLBACK=true
# Сколько секунд жить клиренсу до повторного прохождения проверки
GA_COOKIE_TTL=3600
GA_REQUEST_TIMEOUT=25

# ---------- Планировщик ----------
# Базовый интервал опроса одного товара, секунды
CHECK_INTERVAL=900
# Пауза между запросами внутри цикла, секунды (ровный ритм подозрителен)
CHECK_DELAY_BETWEEN=7.0
# Сколько товаров максимум обрабатывать за один цикл
CHECK_BATCH_SIZE=25

# Сколько раз подряд ЗЯ должен показать новое наличие, прежде чем поверим.
# Источник дрожит: inStock переключается туда-обратно при неизменной цене,
# и без подтверждений бот начинает спамить.
STOCK_CONFIRMATIONS=2
# Минимальный интервал между одинаковыми уведомлениями по товару, секунды
NOTIFY_COOLDOWN=21600

# ---------- Прочее ----------
LOG_LEVEL=INFO
# Через запятую tg id администраторов (доступ к команде /diag).
# Пустое значение закрывает /diag для всех.
ADMIN_IDS=
